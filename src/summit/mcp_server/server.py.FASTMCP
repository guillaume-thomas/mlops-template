import os
from mcp.server.fastmcp import FastMCP
from summit.mcp_server.titanic_tool import TitanicInferenceTool
import uvicorn

API_URL = os.getenv("TITANIC_API_URL", "http://mlops-api-service.gthomas59800-dev.svc.cluster.local:8080")
titanic_tool = TitanicInferenceTool(API_URL)

# FastMCP gère automatiquement FastAPI + SSE
mcp = FastMCP("titanic-mcp-server")

@mcp.tool()
async def predict_survival(
        pclass: int,
        sex: str,
        sibsp: int,
        parch: int
) -> str:
    """
    Predict if a Titanic passenger would survive based on their characteristics.

    Args:
        pclass: Passenger class (1=Upper, 2=Middle, 3=Low)
        sex: Gender of the passenger (male or female)
        sibsp: Number of siblings/spouses aboard the Titanic
        parch: Number of parents/children aboard the Titanic
    """
    result = titanic_tool.predict_survival(
        pclass=pclass,
        sex=sex,
        sibsp=sibsp,
        parch=parch
    )

    if "error" in result:
        return f"Error making prediction: {result['error']}"

    survived_text = "survived" if result["survived"] else "did not survive"
    return f"Based on the passenger characteristics, they {survived_text}. (Prediction: {result['prediction']})"

# FastMCP crée une application FastAPI interne accessible via .app
app = mcp.app

if __name__ == "__main__":
    port = int(os.getenv("PORT", "8000"))
    uvicorn.run(app, host="0.0.0.0", port=port)


